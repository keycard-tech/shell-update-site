{
  "name": "shell-update-site",
  "version": "1.0.0",
  "description": "Keycard Shell update website",
  "private": true,
  "license": "MIT",
  "source": [
    "pages/index.html",
    "pages/update/index.html",
    "pages/update/air-gapped/index.html",
    "pages/update/db-version-history/index.html",
    "pages/firmware/release-notes/index.html",
    "pages/verify/index.html"
  ],
  "scripts": {
    "clean": "rm -rf dist .parcel-cache",
    "scrub": "rm -rf dist pages .parcel-cache .parcel-dev",
    "render": "node scripts/render-pages.mjs",
    "sync": "node scripts/sync-upstream.mjs",
    "prestart": "npm run render && npm run sync",
    "start": "node scripts/dev.mjs",
    "prebuild": "npm run sync && npm run render && rm -rf dist .parcel-cache",
    "build": "parcel build --no-source-maps --public-url \"${SITE_BASE:-/}\"",
    "postbuild": "node scripts/install-media.mjs",
    "serve": "node scripts/serve-site.mjs",
    "check": "node scripts/check-site.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@choppu/shelljs": "^2.0.0",
    "@choppu/shelljs-web-hid": "^2.0.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "html5-qrcode": "^2.3.8",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@types/node": "^26.0.0",
    "parcel": "^2.16.4",
    "typescript": "^6.0.3"
  }
}

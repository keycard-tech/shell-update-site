{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["./src/js/**/*.ts", "./test/**/*.ts"],
  "exclude": ["node_modules", "dist", "pages", "media", ".parcel-cache"]
}
